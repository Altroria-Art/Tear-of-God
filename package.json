{
  "name": "tear-of-god",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:full": "npm run build && wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist --branch=master --project-name=tear-of-god",
    "db:clean": "node -e \"require('fs').rmSync('.wrangler/state/v3/d1',{recursive:true,force:true})\"",
    "db:schema": "wrangler d1 execute tear-of-god-db --local --file=./schema.sql",
    "db:reset": "npm run db:clean && npm run db:schema",
    "db:pull": "wrangler d1 export tear-of-god-db --remote --output=./.d1-snapshot.sql",
    "db:restore": "npm run db:clean && wrangler d1 execute tear-of-god-db --local --file=./.d1-snapshot.sql",
    "db:sync": "npm run db:pull && npm run db:restore",
    "db:migrate:0001": "wrangler d1 execute tear-of-god-db --local --file=./migrations/0001_templates_tiers.sql"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^12.17.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "wrangler": "^4.125.0"
  }
}



